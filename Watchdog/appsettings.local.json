{
  "WatchdogConfig": {
    "Applications": [
      {
        "ProcessName": "notepad",
        "ExePath": "C:\\Windows\\System32\\notepad.exe",
        "CheckIntervalSeconds": 10,
        "MaxRestartsPerWindow": 3,
        "RestartWindowSeconds": 300
      }
    ],
    "WindowsServices": [
      {
        "ServiceName": "DemoWindowsService",
        "CheckIntervalSeconds": 10,
        "MaxRestartsPerWindow": 3,
        "RestartWindowSeconds": 300,
        "RestartAttempts": 5
      },
      {
        "ServiceName": "Test2",
        "CheckIntervalSeconds": 30,
        "MaxRestartsPerWindow": 3,
        "RestartWindowSeconds": 300,
        "RestartAttempts": 5
      }
    ]
  },
  "Serilog": {
    "MinimumLevel": "Debug",
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "DynamicLoggerBase": {
    "LogsPath": "logs",
    "Serilog": {
      "MinimumLevel": "Debug",
      "WriteTo": [
        { "Name": "Console" }
      ]
    }
  }
}
