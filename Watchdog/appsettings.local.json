{
  "WatchdogConfig": {
    "Applications": [
      {
        "ProcessName": "notepad",
        "ExePath": "C:\\Windows\\System32\\notepad.exe",
        "CheckInterval": "00:00:10",
        "MaxRestartsPerWindow": 3,
        "RestartWindow": "00:05:00"
      }
    ],
    "WindowsServices": [
      {
        "ServiceName": "DemoWindowsService",
        "CheckInterval": "00:00:10",
        "MaxRestartsPerWindow": 3,
        "RestartWindow": "00:05:00",
        "RestartAttempts": 5
      },
      {
        "ServiceName": "Test2",
        "CheckInterval": "00:00:30",
        "MaxRestartsPerWindow": 3,
        "RestartWindow": "00:05:00",
        "RestartAttempts": 5
      }
    ]
  },
  "Serilog": {
    "MinimumLevel": "Debug",
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "DynamicLoggerBase": {
    "LogsPath": "logs",
    "Serilog": {
      "MinimumLevel": "Debug",
      "WriteTo": [
        { "Name": "Console" }
      ]
    }
  }
}